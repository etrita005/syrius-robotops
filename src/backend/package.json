{
  "name": "robotops-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx tsx src/index.ts",
    "dev": "npx tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "npx tsx --test --test-force-exit src/test.ts",
