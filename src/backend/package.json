    "hono": "^4.7.0",
    "lru-cache": "^11.5.1",
    "nanoid": "^5.0.0",
    "pino": "^9.14.0",
    "pino-roll": "^4.0.0",
    "ssh2": "^1.17.0",
    "toad-scheduler": "^4.0.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/archiver": "^6.0.2",
    "@types/node": "^25.9.1",
    "@types/ssh2": "^1.15.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
